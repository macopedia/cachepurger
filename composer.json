{
  "name": "macopedia/cachepurger",
  "type": "typo3-cms-extension",
  "description": "Ban Varnish cache objects by tag when TYPO3 clears page caches, from the backend and the CLI",
  "keywords": [
    "typo3",
    "typo3-extension",
    "varnish",
    "cache",
    "purge",
    "ban",
    "http-cache",
    "cache-invalidation"
  ],
  "homepage": "https://github.com/macopedia/cachepurger",
  "license": "GPL-2.0-or-later",
  "support": {
    "issues": "https://github.com/macopedia/cachepurger/issues",
    "source": "https://github.com/macopedia/cachepurger"
  },
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.4",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/log": "^3.0",
    "typo3/cms-core": "^13.4 || ^14.3"
  },
  "autoload": {
    "psr-4": {
      "Macopedia\\CachePurger\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "cachepurger"
    }
  }
}
